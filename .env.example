# Copy to .env.local (development) or set in the hosting environment (staging / production).
# Nothing here is a real credential.

# --- Application ---------------------------------------------------------
# Public base URL, used in e-mail links, public quote links and payment callbacks.
APP_URL=http://localhost:3000

# --- Database ------------------------------------------------------------
# PostgreSQL connection string. Leave empty in development to use the embedded
# database stored in .data/pglite. Required in production.
DATABASE_URL=
# Maximum pooled connections per app instance (default 10).
DB_POOL_MAX=10
# Set to "false" to skip automatic migrations at start-up and run them in a release step instead.
DB_MIGRATE_ON_START=true
# Only for smoke-testing a production build locally. Never set on a real deployment.
ALLOW_EMBEDDED_DB=

# --- E-mail --------------------------------------------------------------
# SMTP connection URL, e.g. smtps://user:password@smtp.example.com:465
# Required in production. Without it, development prints e-mails to the server log
# and shows verification / reset / invite links on screen.
SMTP_URL=
# Production without an SMTP account: e-mail is skipped (never faked), invite links are shown to the inviter,
# password reset links come from `pnpm admin <email> --reset-link`. Leave unset when SMTP_URL is set.
MAIL_OPTIONAL=
MAIL_FROM="Kontura <no-reply@example.com>"
# Receives support form messages; also shown in legal pages.
SUPPORT_EMAIL=

# --- Billing (iyzico Subscription) ---------------------------------------
# Not activated until a merchant account exists. Without keys, plan purchase is disabled.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com   Live: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Needed to verify webhook signatures.
IYZICO_MERCHANT_ID=
# Pricing plan reference codes created in the iyzico panel.
IYZICO_PLAN_STARTER=
IYZICO_PLAN_WORKSHOP=
IYZICO_PLAN_PRO=
# Development / staging only: lets an owner activate a plan without payment.
# Ignored when NODE_ENV=production.
BILLING_TEST_MODE=

# --- Legal identity ------------------------------------------------------
# Shown in terms, privacy and KVKK pages. While empty, those pages display a "template" warning.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
